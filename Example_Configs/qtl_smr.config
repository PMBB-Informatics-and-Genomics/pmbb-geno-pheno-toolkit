// SMR Unit Test Config: Pre-computed LD panels
//
// Tests the standard execution path where .bld LD panel files already exist.
//
// Stub mode (tests pipeline logic; no SMR binary or real .bld files needed):
//   cd SMR/
//   nextflow run qtl_smr.nf -stub -profile non_docker_dev \
//     -c test_data/test_config_precomputed_ld_panels/qtl_smr_test_precomputed.config
//
// Real mode (requires SMR executable on PATH and real .bld files):
//   Replace placeholder .bld files in test_data/test_config_precomputed_ld_panels/Input/
//   with files generated by: smr --make-bld --bfile <plink_prefix> --ld-wind 4000 ...
//   Then run without -stub.

params {
    smr_path         = 'smr'     // must be on PATH for real runs; unused in -stub mode
    my_python        = '/opt/conda/bin/python'

    chromosome_list  = [21, 22]

    // analyses, bin_pheno_list, and quant_pheno_list can each be a
    // Groovy list (as below) or a path to a newline-separated text file.
    analyses         = ['EUR']
    bin_pheno_list   = ['T2D_binary']
    quant_pheno_list = ['BMI_quant', 'LDL_quant']

    cores_per_smr_job = 1

    sumstats_manifest_csv    = "${launchDir}/sumstats_manifest.csv"
    ld_panel_manifest_csv    = "${launchDir}/ld_panel_manifest.csv"
    qtl_dataset_manifest_csv = "${launchDir}/xqtl_manifest.csv"

    // RSID maps: files are at {rsid_maps_prefix}{chr}.txt
    rsid_maps_prefix = "${launchDir}/Input/rsid_map.chr"
}
