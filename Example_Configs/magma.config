/*
 * Test configuration — Layer 1 + Layer 2 (gene burden + gene-set enrichment)
 *
 * Run (stub-run to validate DAG without MAGMA binary):
 *   cd test_data/test_config_genes_and_sets
 *   nextflow run ../../magma.nf -c magma.config -profile standard -stub-run
 *
 * Run (real, requires MAGMA binary and plink2-built plink files):
 *   cd test_data/test_config_genes_and_sets
 *   nextflow run ../../magma.nf -c magma.config -profile standard
 */

params {

    my_python = '/opt/conda/bin/python'
    magma_exe = 'magma'    // must be on PATH (or full path to binary)

    gene_loc = "${launchDir}/../Input/test_gene.loc"

    input_descriptor_table_filename = "${launchDir}/sumstats_manifest.csv"

    chromosome_list = [1, 2]

    input_colnames = [
        chr_col : 'CHR',
        pos_col : 'POS',
        p_col   : 'p-value',
        a1_col  : 'reference_allele',
        a2_col  : 'other_allele'
    ]

    // ── Layer 2 enabled ─────────────────────────────────────────────────────
    run_gene_sets = true

    gene_set_location = "${launchDir}/../Input/"
    gene_sets = [
        TEST : 'test_gene_sets.gmt'
    ]

    skipPostprocessingErrors = false
}
